# Copy to .env for local dev (gitignored — never commit real values).
# Once the backend gets containerized and deployed in-cluster (Phase 4),
# these switch to in-cluster DNS names (e.g. postgres.postgres.svc.cluster.local)
# instead of localhost/ingress.

# Postgres — reached via `kubectl port-forward -n postgres svc/postgres 5432:5432`
# (deliberately has no ingress route, unlike LocalStack/Gitea — a DB
# shouldn't be reachable that way even in local dev).
DATABASE_URL=postgresql+asyncpg://app:<password from infra/PHASE2-RUNBOOK.md step 1>@localhost:5432/app

# "local" disables the cookie Secure flag — required for `next dev` (plain
# HTTP) to be able to store our auth cookies at all. Never anything but
# "local" outside your own machine.
ENVIRONMENT=local
# The Next.js dev server's origin — CORS only allows this exact origin
# through (allow_credentials=True forbids a wildcard, per the Fetch spec).
FRONTEND_ORIGIN=http://localhost:3000

# JWT signing secret — any long random string for local dev.
JWT_SECRET=<generate one, e.g. same way as the Phase 2 passwords>
# 15 min is the real security-appropriate default (matches overview.md).
# Bumped to something longer than 15 locally is reasonable while manually
# curl-testing endpoints — just don't carry that habit into anything real.
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# LocalStack — reached through the ingress from Phase 1, same as the aws CLI.
AWS_ENDPOINT_URL=http://localstack.local
AWS_REGION=us-east-1
# The orchestrator-app IAM user's own keys (terraform output, Phase 1) — used
# ONLY to call sts:AssumeRole. Actual KMS/S3 calls use the short-lived
# credentials that come back from assuming orchestrator-role, never these
# directly.
AWS_ORCHESTRATOR_APP_ACCESS_KEY_ID=<terraform output -raw orchestrator_app_access_key_id>
AWS_ORCHESTRATOR_APP_SECRET_ACCESS_KEY=<terraform output -raw orchestrator_app_secret_access_key>
AWS_ORCHESTRATOR_ROLE_ARN=<terraform output -raw orchestrator_role_arn>
KMS_KEY_ALIAS=alias/ai-builder-orchestrator

# Gitea — reached through the ingress from Phase 2.
GITEA_URL=http://gitea.local
GITEA_ADMIN_USERNAME=admin
GITEA_ADMIN_TOKEN=<create in Gitea: Settings -> Applications -> Generate New Token, scopes: write:organization, write:repository>
